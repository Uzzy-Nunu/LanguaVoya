# Optional Gemini API Key for server-side dialogue generation
# If left unset, LanguaVoya will automatically use its built-in multilingual contextual dialogue engine.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase project settings (the anon key is safe to expose when RLS policies are applied)
NEXT_PUBLIC_SUPABASE_URL=your_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_key_here